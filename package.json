{
  "name": "parche",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "parche — server de sync del vault colectivo de chamba",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc --noEmit && tsup",
    "start": "node dist/main.js",
    "admin": "tsx src/admin/cli.ts",
    "test": "vitest run",
    "lint": "biome check .",
    "lint:write": "biome check --write .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@chamba/core": "^1.7.0",
    "@fastify/rate-limit": "^11.0.0",
    "better-sqlite3": "^11.10.0",
    "drizzle-orm": "^0.44.0",
    "fastify": "^5.12.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.0.0",
    "drizzle-kit": "^0.30.0",
    "tsup": "^8.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ]
  }
}
