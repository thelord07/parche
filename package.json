{
  "name": "parche",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "parche — server de sync del vault colectivo de chamba",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "dev:web": "cd web && vite",
    "build": "pnpm run typecheck && pnpm run build:web && tsup",
    "build:web": "cd web && vite build",
    "start": "node dist/main.js",
    "admin": "tsx src/admin/cli.ts",
    "test": "vitest run",
    "lint": "biome check .",
    "lint:write": "biome check --write .",
    "typecheck": "tsc --noEmit && tsc -p web/tsconfig.json --noEmit"
  },
  "dependencies": {
    "@chamba/core": "^1.7.0",
    "@fastify/cookie": "^11.1.5",
    "@fastify/rate-limit": "^11.0.0",
    "@fastify/static": "^8.3.0",
    "better-sqlite3": "^11.10.0",
    "drizzle-orm": "^0.44.0",
    "fastify": "^5.12.0",
    "nodemailer": "^6.10.1",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@fontsource/instrument-sans": "^5",
    "@fontsource/jetbrains-mono": "^5",
    "@fontsource/space-grotesk": "^5",
    "@testing-library/jest-dom": "^6",
    "@testing-library/react": "^16",
    "@testing-library/user-event": "^14",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@vitejs/plugin-react": "^4",
    "drizzle-kit": "^0.30.0",
    "jsdom": "^25",
    "react": "^18",
    "react-dom": "^18",
    "react-router-dom": "^6",
    "tsup": "^8.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^5",
    "vitest": "^2.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  }
}
