# parche environment variables
# Copy to .env and fill in values as needed.
# Never commit .env to version control.

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------

# Port the server listens on (default: 8787)
PORT=8787

# Host the server binds to (default: 127.0.0.1 for local dev).
# In Docker, docker-compose.yml sets HOST=0.0.0.0 via `environment:` which
# takes precedence over this file — so you do not need to change HOST here
# for Docker deployments.
HOST=127.0.0.1

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------

# Directory where blobs and the SQLite database are stored (default: ./data).
# In Docker, docker-compose.yml sets PARCHE_DATA_DIR=/data via `environment:`
# which takes precedence over this file — do not change it here for Docker.
PARCHE_DATA_DIR=./data

# Maximum blob size in bytes (default: 20971520 = 20 MiB).
# Must match `client_max_body_size` in the nginx config.
PARCHE_MAX_BLOB_BYTES=20971520

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------

# Pino log level: fatal | error | warn | info | debug | trace | silent
# (default: info)
PARCHE_LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Rate-limiting: trust proxy (X-Forwarded-For)
# ---------------------------------------------------------------------------

# Comma-separated list of IP addresses or CIDR blocks that the server should
# trust as upstream proxies. When set, Fastify derives request.ip from the
# X-Forwarded-For header, which makes the join rate limit work correctly
# per real client IP behind nginx.
#
# Leave empty (no value) to disable proxy trust — all requests are limited
# by the direct socket IP (correct for local development without a proxy).
#
# Production value when running behind Docker + nginx on the same host:
#   PARCHE_TRUST_PROXY=172.28.0.1
# (nginx on the host enters the container via the compose bridge gateway;
#  run `docker network inspect parche_parche-net` to confirm the gateway.)
PARCHE_TRUST_PROXY=172.28.0.1

# ---------------------------------------------------------------------------
# Docker compose network (only read by docker-compose.yml, not the app)
# ---------------------------------------------------------------------------

# Bridge network subnet for the parche compose network.
# Change these if 172.28.0.0/16 conflicts with an existing network on the host
# (`ip -4 route` or `docker network ls` to check before the first `up`).
# The gateway address must be consistent with PARCHE_TRUST_PROXY above.
PARCHE_SUBNET=172.28.0.0/16
PARCHE_GATEWAY=172.28.0.1
