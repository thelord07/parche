# parche server configuration
# Copy to .env and fill in the values. NEVER commit .env to version control.

# Public URL of this server (used to build magic link URLs in emails)
# Required in production (the server refuses to start without it); optional in dev
PARCHE_PUBLIC_URL=https://parche.example.com

# SMTP URL for sending magic link emails
# Required to start the server (smtp:// or smtps://)
# Production format: smtp://user:password@smtp.example.com:587
# or with TLS:      smtps://user:password@smtp.example.com:465
PARCHE_SMTP_URL=smtp://127.0.0.1:1025

# "From" address for outgoing emails
# Defaults to parche@<host of PARCHE_PUBLIC_URL>
PARCHE_MAIL_FROM=parche@example.com

# Comma-separated list of emails allowed to create new parches (groups)
# Others can only join via invite
PARCHE_CREATORS=you@example.com

# Secret-scan gate on PUT /api/blob/:hash: report|block. Default: report.
# "report" stores the blob and only logs/records the finding. Switch to
# "block" (422 secret_detected with kinds+findings, blob not stored) only in
# this order (PARCHE-013):
#   1. the whole team is on a chamba client >= 1.15.1 (sends
#      X-Parche-Secret-Allow and handles the `findings` field in the 422);
#   2. this server (PARCHE-013) is deployed, so client and server scan with
#      the same @chamba/core rules;
#   3. only then set PARCHE_SECRET_GATE=block.
# Reversing steps 2 and 3 turns every already-exempted false positive into an
# unrecoverable 422 for clients still on the server's old rules. The
# dashboard warning for owner/admin works the same in both modes.
PARCHE_SECRET_GATE=report

# --- Existing vars ---
PORT=8787
HOST=127.0.0.1
PARCHE_DATA_DIR=./data
PARCHE_LOG_LEVEL=info
# PARCHE_TRUST_PROXY=172.28.0.1
